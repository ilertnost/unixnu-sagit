+  { 0x8F, 0x62, 0x1A, 0x55, 0x9D, 0x3E, 0x70, 0x11 }
+};
+
+STATIC CHAR16  mStatusName[] = L"SagitRamDisk";
+
+STATIC
+VOID
+SetDiag (

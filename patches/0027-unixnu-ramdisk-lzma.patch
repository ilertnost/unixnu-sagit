+//
+// The payload volume may travel LZMA-compressed: a self-describing header
+// followed by an LZMA-alone stream that expands to the FAT volume the loader
+// reads. The Mi 6 bootloader refuses boot images whose ramdisk section
+// exceeds roughly 36 MiB, so the 40+ MiB volume of a prelinked kernel has to
+// travel packed and expand here, before the block device is published.
+//
+#define LZMA_PAYLOAD_MAGIC  SIGNATURE_64 ('U', 'N', 'X', 'L', 'Z', 'M', 'A', '1')
+
+#pragma pack(1)
+typedef struct {
+  UINT64    Magic;
+  UINT32    Version;
+  UINT32    HeaderSize;
+  UINT64    StoredSize;
+  UINT64    ExpandedSize;
+  UINT32    StreamCrc;
+  UINT32    RawCrc;
+  UINT8     Reserved[32];
+} LZMA_PAYLOAD_HEADER;
+#pragma pack()
+
+// Raw entry points of MdeModulePkg/Library/LzmaCustomDecompressLib.
+EFI_STATUS
+EFIAPI
+LzmaUefiDecompressGetInfo (
+  IN  CONST VOID  *Source,
+  IN  UINT32      SourceSize,
+  OUT UINT32      *DestinationSize,
+  OUT UINT32      *ScratchSize
+  );
+
+EFI_STATUS
+EFIAPI
+LzmaUefiDecompress (
+  IN  CONST VOID  *Source,
+  IN  UINTN       SourceSize,
+  IN  VOID        *Destination,
+  IN  VOID        *Scratch
+  );
+
 STATIC UINT8                    *mRamBase;
 STATIC EFI_BLOCK_IO_MEDIA       mMedia;
 

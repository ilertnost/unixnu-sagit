+//
+// Expand an LZMA-compressed payload into a freshly allocated buffer.
+// Returns NULL when the payload is not compressed or fails to expand; the
+// caller then publishes the raw bytes as before.
+//
+STATIC
+UINT8 *
+ExpandLzmaPayload (
+  IN  CONST VOID  *Payload,
+  IN  UINTN       PayloadSize,
+  OUT UINTN       *ExpandedSize
+  )
+{
+  CONST LZMA_PAYLOAD_HEADER  *Header;
+  CONST UINT8                *Stream;
+  UINTN                      StreamSize;
+  UINT32                     DestinationSize;
+  UINT32                     ScratchSize;
+  VOID                       *Scratch;
+  UINT8                      *Expanded;
+  UINT32                     Crc;
+  EFI_STATUS                 Status;
+
+  Header = (CONST LZMA_PAYLOAD_HEADER *)Payload;
+  if ((PayloadSize < sizeof (LZMA_PAYLOAD_HEADER)) ||
+      (Header->Magic != LZMA_PAYLOAD_MAGIC) ||
+      (Header->Version != 1) ||
+      (Header->HeaderSize != sizeof (LZMA_PAYLOAD_HEADER)) ||
+      (Header->StoredSize > PayloadSize - sizeof (LZMA_PAYLOAD_HEADER)) ||
+      (Header->ExpandedSize < RAM_BLOCK_SIZE) ||
+      ((Header->ExpandedSize % RAM_BLOCK_SIZE) != 0))
+  {
+    SetDiag ("lzma: header invalid");
+    return NULL;
+  }
+
+  Stream      = (CONST UINT8 *)Payload + Header->HeaderSize;
+  StreamSize  = (UINTN)Header->StoredSize;
+  Status = LzmaUefiDecompressGetInfo (Stream, (UINT32)StreamSize, &DestinationSize, &ScratchSize);
+  if (EFI_ERROR (Status) || (DestinationSize != Header->ExpandedSize)) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: LZMA info failed or size mismatch %r\n", Status));
+    SetDiag ("lzma: info failed or size mismatch");
+    return NULL;
+  }
+
+  Expanded = AllocatePages (EFI_SIZE_TO_PAGES (DestinationSize));
+  if (Expanded == NULL) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no room for the expanded payload\n"));
+    SetDiag ("lzma: no room for the expanded payload");
+    return NULL;
+  }
+
+  Scratch = AllocatePool (ScratchSize);
+  if (Scratch == NULL) {
+    FreePages (Expanded, EFI_SIZE_TO_PAGES (DestinationSize));
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no room for the LZMA scratch\n"));
+    SetDiag ("lzma: no room for the scratch");
+    return NULL;
+  }
+
+  Status = LzmaUefiDecompress (Stream, StreamSize, Expanded, Scratch);
+  FreePool (Scratch);
+  if (EFI_ERROR (Status)) {
+    FreePages (Expanded, EFI_SIZE_TO_PAGES (DestinationSize));
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: LZMA decode failed %r\n", Status));
+    SetDiag ("lzma: decode failed");
+    return NULL;
+  }
+
+  Crc = 0;
+  Status = gBS->CalculateCrc32 (Expanded, DestinationSize, &Crc);
+  if (EFI_ERROR (Status) || (Crc != Header->RawCrc)) {
+    FreePages (Expanded, EFI_SIZE_TO_PAGES (DestinationSize));
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: expanded payload CRC mismatch\n"));
+    SetDiag ("lzma: expanded payload CRC mismatch");
+    return NULL;
+  }
+
+  *ExpandedSize = DestinationSize;
+  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: expanded %u bytes to %u bytes\n", (UINT32)PayloadSize, DestinationSize));
+  SetDiag ("lzma ok");
+  return Expanded;
+}

@@ -224,6 +224,14 @@ struct IORPC {
 	IORPCMessageMach * reply;
 	uint32_t           sendSize;
 	uint32_t           replySize;
+#ifdef KERNEL
+	/*
+	 * The parsed message header. iOS 17's DriverKit generator emits calls

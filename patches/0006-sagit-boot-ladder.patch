+		sagit_bar_paint(base, sagit_ladder_row, bar, color);
+	}
+	sagit_paint_next = index + 1;
+	sagit_dbg(23);
+	sagit_number(base, sagit_ladder_row, index, 0);
+	sagit_number(base, sagit_ladder_row, index, 1);
+	sagit_dbg(24);
+	if (overflow) {
+		sagit_paint_next = index;
+	} else {
+		sagit_bar_next = index + 1;
+	}

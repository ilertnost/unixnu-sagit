diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -128,6 +128,135 @@
 SECURITY_READ_ONLY_LATE(unsigned long) gT0Sz = T0SZ_BOOT;
 SECURITY_READ_ONLY_LATE(unsigned long) gT1Sz = T1SZ_BOOT;
 
+/* <arm/machine_routines.h> without dragging the whole machine layer in here. */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size,
+    uint32_t flags);
+
+/*
+ * Sagit bring-up ladder, C half.
+ *
+ * There is no console between the loader branch and the point in
+ * kernel_bootstrap() where the screen is acquired: PE_create_console() only
+ * prepares the framebuffer, text is emitted after kPEAcquireScreen. A fault in
+ * that window is silent, so each checkpoint paints one square into the
+ * framebuffer the loader handed over in boot_args.Video[0].
+ *
+ * The framebuffer is not in the 256 MB boot window, so it is reached in three
+ * different ways: with the MMU off (and through the V=P bootstrap map, which
+ * carries block entries for it) it is the physical address itself; after
+ * arm_vm_init() replaced TTBR0 it is mapped once with ml_io_map_unmappable(),
+ * exactly like the video console will map it a few calls later.
+ *
+ * Stages and colors, in order: 0 white, 1 yellow, 2 cyan, 3 green, 4 blue,
+ * 5 orange, 6 magenta, 7 purple, 8 teal, 9 red, 10 spring green. A missing
+ * square is the first checkpoint that did not run.
+ */
+#define SAGIT_LADDER_COUNT 11
+static const uint32_t sagit_ladder_color[SAGIT_LADDER_COUNT] = {
+	0xFFFFFFFF,     /* 0  loader branch taken */
+	0xFFFFFF00,     /* 1  bootstrap page tables built */
+	0xFF00FFFF,     /* 2  translation registers set, MMU off */
+	0xFF00FF00,     /* 3  MMU on */
+	0xFF0000FF,     /* 4  end of start.s */
+	0xFFFF8000,     /* 5  C entry reached, framebuffer recorded */
+	0xFFFF00FF,     /* 6  arm_init() entered */
+	0xFF8000FF,     /* 7  arm_vm_init() returned */
+	0xFF008080,     /* 8  console prepared */
+	0xFFFF0000,     /* 9  arm_init() finished */
+	0xFF00FF80,     /* 10 screen acquired, kprintf visible */
+};
+
+#define SAGIT_LADDER_X      64
+#define SAGIT_LADDER_Y      140
+#define SAGIT_LADDER_SQUARE 64
+#define SAGIT_LADDER_STRIDE 80
+
+static uint64_t sagit_ladder_fb;
+static uint32_t sagit_ladder_row;
+static uint64_t sagit_ladder_bytes;
+static uint64_t sagit_ladder_map;
+
+static void
+sagit_ladder_paint(uint64_t fb, uint32_t row_bytes, unsigned stage)
+{
+	uint32_t color;
+	uint64_t y, x;
+	uint64_t origin;
+
+	if (!fb || !row_bytes || stage >= SAGIT_LADDER_COUNT) {
+		return;
+	}
+	color = sagit_ladder_color[stage];
+	/* One 64x64 square per stage, on a band below the handoff bar. */
+	origin = fb + (SAGIT_LADDER_X + stage * SAGIT_LADDER_STRIDE);
+
+	for (y = SAGIT_LADDER_Y; y < SAGIT_LADDER_Y + SAGIT_LADDER_SQUARE; y++) {
+		uint64_t row = origin + y * row_bytes;
+
+		for (x = 0; x < SAGIT_LADDER_SQUARE * 4; x += 4) {
+			*(volatile uint32_t *)(uintptr_t)(row + x) = color;
+		}
+		/*
+		 * Rows are 32-byte aligned (rowBytes is 4320), so a 256-byte row
+		 * touches five cache lines; clean six from the rounded-down
+		 * address and let the display controller read DRAM.
+		 */
+		for (x = 0; x < 6; x++) {
+			uint64_t line = (row & ~63ULL) + x * 64;
+
+			__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+		}
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+}
+
+/*
+ * Called from start.s, which has boot_args only as a physical address. Also
+ * records the framebuffer so the C checkpoints below can paint.
+ */
+void
+sagit_mark_args(void *args_pa, unsigned stage)
+{
+	boot_args *args = (boot_args *)args_pa;
+
+	sagit_ladder_fb = (uint64_t)args->Video.v_baseAddr & ~3ULL;
+	sagit_ladder_row = (uint32_t)args->Video.v_rowBytes;
+	sagit_ladder_bytes = (uint64_t)sagit_ladder_row * (uint32_t)args->Video.v_height;
+	sagit_ladder_paint(sagit_ladder_fb, sagit_ladder_row, stage);
+}
+
+void
+sagit_mark(unsigned stage)
+{
+	uint64_t fb = sagit_ladder_fb;
+
+	if (!fb || !sagit_ladder_row) {
+		return;
+	}
+
+	/*
+	 * Until arm_vm_init() switches TTBR0, the V=P bootstrap map is still in
+	 * place and the physical address works.
+	 */
+	if (gVirtBase == 0) {
+		sagit_ladder_paint(fb, sagit_ladder_row, stage);
+		return;
+	}
+
+	/*
+	 * After that the linear window only covers the 256 MB boot window, and
+	 * the framebuffer lives above it. Map it once, the way the video console
+	 * maps it in PE_create_console().
+	 */
+	if (!sagit_ladder_map) {
+		sagit_ladder_map = ml_io_map_unmappable((vm_offset_t)fb,
+		    (vm_size_t)sagit_ladder_bytes, VM_WIMG_WCOMB);
+	}
+	if (sagit_ladder_map) {
+		sagit_ladder_paint(sagit_ladder_map, sagit_ladder_row, stage);
+	}
+}
+
 /* 23543331 - step 1 of kext / kernel __TEXT and __DATA colocation is to move
  * all kexts before the kernel.  This is only for arm64 devices and looks
  * something like the following:
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -456,6 +456,64 @@
 .endmacro
 
 /*
+ * Sagit bring-up ladder, assembler half.
+ *
+ * XNU acquires the screen only late in kernel_bootstrap(), so a fault anywhere
+ * between the loader branch and that point leaves no output at all. Paint the
+ * square for \stage directly into the handoff framebuffer instead: one 64x64
+ * block at y=140, x=64+stage*80. The color comes from the caller in w15 and
+ * the stage number from the caller in the offset.
+ *
+ * The boot_args structure lives at physical address x20 for the whole of
+ * start.s, and both V=P maps (bootstrap and, with the MMU off, the raw
+ * physical address) reach it. The framebuffer also gets V=P block entries in
+ * Lbootstrap_tables_ready, so the same physical address is valid before and
+ * after the MMU comes on.
+ *
+ * Clobbers x9-x13 and x16/x17; no stack is used.
+ */
+.macro SAGIT_LADDER stage
+	ldr		x9, [x20, #0x28]			// boot_args.Video.v_baseAddr
+	bic		x9, x9, #3
+	cbz		x9, 9f
+	ldr		x10, [x20, #0x38]			// boot_args.Video.v_rowBytes
+	cbz		x10, 9f
+	add		x17, x9, #(64 + (\stage) * 80)		// square origin
+
+	/* Fill 64 rows of 64 pixels, two pixels per store. */
+	mov		x11, #140
+	add		x12, x11, #64
+1:	madd		x13, x11, x10, x17
+	mov		w16, #32
+2:	stp		w15, w15, [x13], #8
+	subs		w16, w16, #1
+	b.ne		2b
+	add		x11, x11, #1
+	cmp		x11, x12
+	b.lo		1b
+
+	/*
+	 * The V=P map is write-back and the display controller scans DRAM, so
+	 * clean the lines the square touches. A row is 256 bytes but rows are
+	 * only 32-byte aligned (rowBytes is 4320), hence six lines from the
+	 * rounded-down address; over-cleaning is harmless.
+	 */
+	mov		x11, #140
+1:	madd		x13, x11, x10, x17
+	bic		x13, x13, #63
+	mov		w16, #6
+2:	dc		civac, x13
+	add		x13, x13, #64
+	subs		w16, w16, #1
+	b.ne		2b
+	add		x11, x11, #1
+	cmp		x11, x12
+	b.lo		1b
+	dsb		sy
+9:
+.endmacro
+
+/*
  * _start_first_cpu
  * Cold boot init routine.  Called from __start
  *   x0 - Boot args
@@ -513,6 +571,11 @@
 	msr		SPSel, #0							// Set SP_EL0 to interrupt stack
 	mov		sp, x0
 
+	// Ladder 0: the loader's branch landed and the stacks exist. White.
+	movz	w15, #0xFFFF
+	movk	w15, #0xFFFF, lsl #16
+	SAGIT_LADDER 0
+
 	// Load address to the C init routine into link register
 	adrp	lr, EXT(arm_init)@page
 	add		lr, lr, EXT(arm_init)@pageoff
@@ -626,6 +689,61 @@
 	/* Ensure TTEs are visible */
 	dsb		ish
 
+	// Ladder 1: both bootstrap maps were built without exhausting the pool.
+	// Yellow.
+	movz	w15, #0xFF00
+	movk	w15, #0xFFFF, lsl #16
+	SAGIT_LADDER 1
+
+	/*
+	 * The loader keeps the framebuffer outside the kernel window (SimpleFb
+	 * lives at 0x9d400000 on this SoC), but the later checkpoints paint into
+	 * it with the MMU on. Add block entries for it to the V=P map while the
+	 * tables are still writable. It shares the L1 slot with the kernel
+	 * window, so the L2 table already exists; a missing table means the
+	 * layout is not what we expect and the checkpoints stay unavailable.
+	 */
+	ldr		x6, [x20, #0x28]			// boot_args.Video.v_baseAddr
+	bic		x6, x6, #3
+	cbz		x6, 9f
+	ldr		w7, [x20, #0x38]			// v_rowBytes
+	ldr		w8, [x20, #0x48]			// v_height
+	mul		w7, w7, w8				// framebuffer bytes
+	cbz		w7, 9f
+
+	/* Round [base, base + size) up to whole L2 blocks. */
+	movz	x13, #(ARM_TT_L2_SIZE >> 16), lsl #16
+	sub		x13, x13, #1
+	add		x7, x7, x13
+	mov		x9, x6
+	and		x6, x6, #(ARM_TTE_BLOCK_L2_MASK)
+	sub		x9, x9, x6
+	add		x7, x7, x9
+	lsr		x7, x7, #(ARM_TT_L2_SHIFT)
+
+	and		x9, x6, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x9, x9, #(ARM_TT_L1_SHIFT)
+	lsl		x9, x9, #(TTE_SHIFT)
+	add		x9, x25, x9
+	ldr		x10, [x9]
+	and		x10, x10, #(ARM_TTE_TABLE_MASK)
+	cbz		x10, 9f
+
+	and		x11, x6, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x11, x11, #(ARM_TT_L2_SHIFT)
+	lsl		x11, x11, #(TTE_SHIFT)
+	add		x10, x10, x11
+
+	mov		x12, #(ARM_TTE_BOOT_BLOCK)
+	and		x13, x6, #(ARM_TTE_BLOCK_L2_MASK)
+	orr		x12, x12, x13
+	movz	x13, #(ARM_TT_L2_SIZE >> 16), lsl #16
+1:	str		x12, [x10], #(1 << TTE_SHIFT)
+	add		x12, x12, x13
+	subs		w7, w7, #1
+	b.ne		1b
+	dsb		ish
+9:
 
 	b		common_start
 
@@ -761,11 +879,23 @@
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
 #endif /* HAS_APPLE_PAC */
 
+	// Ladder 2: translation registers and vectors set, about to turn the MMU
+	// on. Cyan; still running with the MMU off.
+	movz	w15, #0xFFFF
+	movk	w15, #0xFF00, lsl #16
+	SAGIT_LADDER 2
+
 	// Enable caches, MMU, ROP and JOP
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+	// Ladder 3: the MMU is on and execution continued through the new tables.
+	// Green; painted through the V=P map.
+	movz	w15, #0xFF00
+	movk	w15, #0xFF00, lsl #16
+	SAGIT_LADDER 3
+
 #if !VMAPPLE
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -810,6 +940,19 @@
 	msr		CPU_OVRD, x9
 #endif
 
+	// Ladder 4: end of the assembler path, about to call into C. Blue.
+	movz	w15, #0x00FF
+	movk	w15, #0xFF00, lsl #16
+	SAGIT_LADDER 4
+
+	// Ladder 5: hand over to C, which also records the framebuffer for the
+	// later checkpoints. Orange.
+	mov		x19, lr
+	mov		x0, x20
+	mov		w1, #5
+	bl		EXT(sagit_mark_args)
+	mov		lr, x19
+
 	// If x21 != 0, we're doing a warm reset, so we need to trampoline to the kernel pmap.
 	cbnz	x21, Ltrampoline
 

+/* <arm/machine_routines.h> without dragging the whole machine layer in here. */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size,
+    uint32_t flags);
+
+/*
+ * Sagit bring-up ladder, C half.
+ *
+ * There is no console between the loader branch and the point in
+ * kernel_bootstrap() where the screen is acquired: PE_create_console() only
+ * prepares the framebuffer, text is emitted after kPEAcquireScreen. A fault in
+ * that window is silent, so the C half reports progress by painting into the
+ * framebuffer the loader handed over in boot_args.Video[0].
+ *
+ * start.s paints its own six coloured squares on a row at y=140; those prove
+ * that the bootstrap page tables, the MMU and the framebuffer mapping survive
+ * the handover. Everything after that is counted here instead of encoded in
+ * colour, because a photograph of a dim screen cannot tell magenta from purple
+ * but can tell how far down a column of green bars reaches:
+ *
+ *   one 320x30 bar per checkpoint, starting at (64, 320), 36 pixels per step,
+ *   green until TTBR0 is replaced, cyan afterwards. The bar index of the last
+ *   painted band times 36 plus 320 is the y of its bottom edge, so a photo
+ *   only has to be measured, not counted.
+ *
+ * Three ways to reach the framebuffer, in order of the handover:
+ *   - before arm_vm_init() takes gVirtBase away, the V=P bootstrap map still
+ *     carries block entries for it, so the physical address works;
+ *   - after that, the kernel physmap covers all of RAM, framebuffer included,
+ *     so phystokv() of the physical address works;
+ *   - if the framebuffer is outside reported memory, fall back to the mapping
+ *     the video console itself uses, ml_io_map_unmappable().
+ */
+#define SAGIT_LADDER_X      64
+#define SAGIT_LADDER_Y      140
+#define SAGIT_LADDER_SQUARE 64
+#define SAGIT_LADDER_STRIDE 80
+
+#define SAGIT_BAR_X         64
+#define SAGIT_BAR_Y         320
+#define SAGIT_BAR_WIDTH     320
+#define SAGIT_BAR_HEIGHT    30
+#define SAGIT_BAR_STRIDE    36
+#define SAGIT_BAR_MAX       40
+
+#define SAGIT_COLOR_BEFORE  0xFF00FF00      /* green: before the TTBR0 switch */
+#define SAGIT_COLOR_AFTER   0xFF00FFFF      /* cyan: after it */
+
+static uint64_t sagit_ladder_fb;
+static uint32_t sagit_ladder_row;
+static uint64_t sagit_ladder_bytes;
+static uint64_t sagit_ladder_map;
+static unsigned sagit_bar_next;
+static boolean_t sagit_kva_live;
+
+static void
+sagit_clean(uint64_t vaddr, uint64_t bytes)
+{
+	uint64_t line;
+
+	for (line = vaddr & ~63ULL; line < vaddr + bytes; line += 64) {
+		__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+	}
+}
+
+static void
+sagit_ladder_paint(uint64_t fb, uint32_t row_bytes, unsigned stage)
+{
+	uint32_t color = 0;
+	uint64_t y, x;
+	uint64_t origin;
+
+	if (!fb || !row_bytes || stage >= 6) {
+		return;
+	}
+	/*
+	 * Colours of the row start.s paints. Only stage 5 is painted here, the
+	 * one start.s asks for when it hands the framebuffer over.
+	 */
+	switch (stage) {
+	case 0: color = 0xFFFFFFFF; break;
+	case 1: color = 0xFFFFFF00; break;
+	case 2: color = 0xFF00FFFF; break;
+	case 3: color = 0xFF00FF00; break;
+	case 4: color = 0xFF0000FF; break;
+	case 5: color = 0xFFFF8000; break;
+	}
+	origin = fb + (uint64_t)(SAGIT_LADDER_X + stage * SAGIT_LADDER_STRIDE) * 4;
+
+	for (y = SAGIT_LADDER_Y; y < SAGIT_LADDER_Y + SAGIT_LADDER_SQUARE; y++) {
+		uint64_t row = origin + y * row_bytes;
+
+		for (x = 0; x < SAGIT_LADDER_SQUARE * 4; x += 4) {
+			*(volatile uint32_t *)(uintptr_t)(row + x) = color;
+		}
+		sagit_clean(row, SAGIT_LADDER_SQUARE * 4);
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+}
+
+/*
+ * Paints one 320x30 bar and the 6 black rows that separate it from the next
+ * one, so the column reads as a stack of blocks however the photo is exposed.
+ */
+static void
+sagit_bar_paint(uint64_t fb, uint32_t row_bytes, unsigned index, uint32_t color)
+{
+	uint64_t y, x;
+	uint64_t origin;
+
+	if (!fb || !row_bytes || index >= SAGIT_BAR_MAX) {
+		return;
+	}
+	origin = fb + (uint64_t)(SAGIT_BAR_Y + index * SAGIT_BAR_STRIDE) * row_bytes
+	    + (uint64_t)SAGIT_BAR_X * 4;
+
+	for (y = 0; y < SAGIT_BAR_STRIDE; y++) {
+		uint32_t pixel = (y < SAGIT_BAR_HEIGHT) ? color : 0;
+		uint64_t row = origin + y * row_bytes;
+
+		for (x = 0; x < SAGIT_BAR_WIDTH * 4; x += 4) {
+			*(volatile uint32_t *)(uintptr_t)(row + x) = pixel;
+		}
+		sagit_clean(row, SAGIT_BAR_WIDTH * 4);
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+}
+
+/*
+ * Called from start.s, which has boot_args only as a physical address. Also
+ * records the framebuffer for the checkpoints below.
+ */
+void
+sagit_mark_args(void *args_pa, unsigned stage)
+{
+	boot_args *args = (boot_args *)args_pa;
+
+	sagit_ladder_fb = (uint64_t)args->Video.v_baseAddr & ~3ULL;
+	sagit_ladder_row = (uint32_t)args->Video.v_rowBytes;
+	sagit_ladder_bytes = (uint64_t)sagit_ladder_row * (uint32_t)args->Video.v_height;
+	sagit_ladder_paint(sagit_ladder_fb, sagit_ladder_row, stage);
+}
+
+/*
+ * One checkpoint. Paints the next bar of the column and returns.
+ */
+void
+sagit_step(void)
+{
+	uint64_t fb = sagit_ladder_fb;
+	uint64_t fb_end = fb + sagit_ladder_bytes;
+	unsigned index = sagit_bar_next;
+
+	if (!fb || !sagit_ladder_row || index >= SAGIT_BAR_MAX) {
+		return;
+	}
+
+	if (!sagit_kva_live) {
+		/* V=P bootstrap map, framebuffer at its physical address. */
+		sagit_bar_paint(fb, sagit_ladder_row, index, SAGIT_COLOR_BEFORE);
+		sagit_bar_next = index + 1;
+		return;
+	}
+
+	if (gPhysSize != 0 && fb >= (uint64_t)gPhysBase &&
+	    fb_end <= (uint64_t)gPhysBase + gPhysSize) {
+		/* The kernel physmap covers all of RAM, framebuffer included. */
+		sagit_bar_paint(phystokv((vm_offset_t)fb), sagit_ladder_row, index,
+		    SAGIT_COLOR_AFTER);
+		sagit_bar_next = index + 1;
+		return;
+	}
+
+	if (!sagit_ladder_map) {
+		sagit_ladder_map = ml_io_map_unmappable((vm_offset_t)fb,
+		    (vm_size_t)sagit_ladder_bytes, VM_WIMG_WCOMB);
+	}
+	if (sagit_ladder_map) {
+		sagit_bar_paint(sagit_ladder_map, sagit_ladder_row, index,
+		    SAGIT_COLOR_AFTER);
+		sagit_bar_next = index + 1;
+	}
+}

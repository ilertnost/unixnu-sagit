+/*
+ * Decimal readout of the checkpoint, painted in two corners.
+ *
+ * Measuring the bars works until the boot menu is redrawn over the
+ * framebuffer on the next boot: its boxes cover the middle of the second
+ * column, which is exactly where the interesting checkpoints land.  A number
+ * in a corner is read from the photograph instead of a stack being counted.
+ */
+#define SAGIT_COUNT_X       820
+#define SAGIT_COUNT_Y       120
+#define SAGIT_COUNT_MARGIN  90
+
+static const uint8_t sagit_digit_row[10][5] = {
+	{ 7, 5, 5, 5, 7 }, { 2, 6, 2, 2, 7 }, { 7, 1, 7, 4, 7 },
+	{ 7, 1, 7, 1, 7 }, { 5, 5, 7, 1, 1 }, { 7, 4, 7, 1, 7 },
+	{ 7, 4, 7, 5, 7 }, { 7, 1, 1, 1, 1 }, { 7, 5, 7, 5, 7 },
+	{ 7, 5, 7, 1, 7 },
+};
+
+static void
+sagit_fill(uint64_t base, uint32_t row_bytes, uint64_t x, uint64_t y,
+    uint64_t width, uint64_t height, uint32_t colour)
+{
+	uint64_t row, column;
+
+	for (row = 0; row < height; row++) {
+		uint64_t line = base + (y + row) * row_bytes + x * 4;
+
+		for (column = 0; column < width; column++) {
+			*(volatile uint32_t *)(uintptr_t)(line + column * 4) =
+			    colour;
+		}
+		sagit_clean(line, width * 4);
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+}
+
+static void
+sagit_number(uint64_t base, uint32_t row_bytes, unsigned value, int low)
+{
+	const uint64_t scale = 8;
+	const uint64_t gap = 8;
+	uint64_t width = (3 * scale) * 2 + gap;
+	uint64_t height = 5 * scale;
+	uint64_t x = SAGIT_COUNT_X;
+	uint64_t y = SAGIT_COUNT_Y;
+	unsigned digits[2];
+	unsigned index, row, column;
+
+	if (low) {
+		uint64_t rows = sagit_ladder_row ? sagit_ladder_bytes /
+		    sagit_ladder_row : 0;
+
+		if (rows < height + SAGIT_COUNT_MARGIN) {
+			return;
+		}
+		y = rows - height - SAGIT_COUNT_MARGIN;
+	}
+	if (value > 99) {
+		value = 99;
+	}
+	digits[0] = value / 10;
+	digits[1] = value % 10;
+
+	sagit_fill(base, row_bytes, x, y, width, height, 0);
+	for (index = 0; index < 2; index++) {
+		uint64_t dx = x + index * (3 * scale + gap);
+
+		for (row = 0; row < 5; row++) {
+			for (column = 0; column < 3; column++) {
+				if (sagit_digit_row[digits[index]][row] &
+				    (4u >> column)) {
+					sagit_fill(base, row_bytes,
+					    dx + column * scale,
+					    y + row * scale, scale, scale,
+					    0xFFFFFFFF);
+				}
+			}
+		}
+	}
+}
+
+/*
+ * A marker inside one checkpoint, painted as 91, 92, 93 so it cannot be
+ * mistaken for a checkpoint number. Every caller sits between checkpoint 29
+ * and the TTBR0 switch, so the V=P map is still the way in.
+ */
+static void
+sagit_mark_phase(unsigned phase)
+{
+	uint64_t fb = sagit_ladder_fb;
+
+	if (!fb || !sagit_ladder_row || sagit_kva_live) {
+		return;
+	}
+	sagit_number(fb, sagit_ladder_row, 90 + phase, 0);
+	sagit_number(fb, sagit_ladder_row, 90 + phase, 1);
+}

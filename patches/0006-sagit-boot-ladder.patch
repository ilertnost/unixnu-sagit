+#define SAGIT_BAR_X         64
+#define SAGIT_BAR_Y         320
+#define SAGIT_BAR_WIDTH     320
+#define SAGIT_BAR_HEIGHT    36
+#define SAGIT_BAR_STRIDE    45
+#define SAGIT_BAR_ROWS      21
+#define SAGIT_BAR_COLUMNS   2
+#define SAGIT_BAR_MAX       (SAGIT_BAR_ROWS * SAGIT_BAR_COLUMNS)
+
+#define SAGIT_COLOR_BEFORE  0xFF00FF00      /* green: before the TTBR0 switch */
+#define SAGIT_COLOR_AFTER   0xFF00FFFF      /* cyan: after it */
+#define SAGIT_COLOR_OVER    0xFFFF0000      /* red: more checkpoints than bars */

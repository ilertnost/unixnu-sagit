 /*
+ * Sagit bring-up ladder, assembler half.
+ *
+ * XNU acquires the screen only late in kernel_bootstrap(), so a fault anywhere
+ * between the loader branch and that point leaves no output at all. Paint the
+ * square for \stage directly into the handoff framebuffer instead: one 64x64
+ * block at y=140, x=64+stage*80.
+ *
+ * The boot_args structure lives at physical address x20 for the whole of
+ * start.s. The framebuffer is not inside the 256 MB boot window (the loader
+ * hands over window 0x44c04000..0x54c04000 while SimpleFb lives at
+ * 0x9d400000), so Lbootstrap_tables_ready gives it its own L2 table in the V=P
+ * map. Without that the first store after the MMU comes on takes a
+ * translation fault and the ladder stops at stage 2.
+ *
+ * SAGIT_FILL takes x17 as the pixel address of the square's top-left corner,
+ * x10 as v_rowBytes and w15 as the colour. It clobbers x11-x13 and w16 and
+ * cleans every line it touched, because the V=P map is write-back while the
+ * display controller scans DRAM.
+ */
+.macro SAGIT_FILL
+	mov		x12, x17
+	mov		w11, #64
+1:	mov		w16, #32
+2:	stp		w15, w15, [x17], #8
+	subs		w16, w16, #1
+	b.ne		2b
+	add		x17, x17, x10
+	sub		x17, x17, #256
+	subs		w11, w11, #1
+	b.ne		1b
+
+	/*
+	 * A row is 256 bytes but rows are only 32-byte aligned (rowBytes is
+	 * 4320), hence six lines from the rounded-down address; over-cleaning
+	 * is harmless.
+	 */
+	mov		x17, x12
+	mov		w11, #64
+1:	mov		x13, x17
+	bic		x13, x13, #63
+	mov		w16, #6
+2:	dc		civac, x13
+	add		x13, x13, #64
+	subs		w16, w16, #1
+	b.ne		2b
+	add		x17, x17, x10
+	subs		w11, w11, #1
+	b.ne		1b
+	dsb		sy
+.endmacro
+
+.macro SAGIT_LADDER stage
+	ldr		x9, [x20, #0x28]			// boot_args.Video.v_baseAddr
+	bic		x9, x9, #3
+	cbz		x9, 9f
+	ldr		x10, [x20, #0x38]			// boot_args.Video.v_rowBytes
+	cbz		x10, 9f
+	add		x17, x9, #(4 * (64 + (\stage) * 80))	// square origin, bytes
+	mov		x11, #140
+	madd	x17, x11, x10, x17
+	SAGIT_FILL
+9:
+.endmacro
+
+/*
+ * Translate \reg with the MMU still off. AT S1E1R consults TTBR0/TCR_EL1
+ * whatever SCTLR_EL1.M says, so this is the pre-flight check for the tables
+ * the MMU is about to use: PAR_EL1.F clear means the address resolves, set
+ * means it would fault. Green square for resolve, red for fault, at \yy.
+ */
+.macro SAGIT_PROBE reg, xoff, yy
+	at		s1e1r, \reg
+	isb
+	mrs		x16, PAR_EL1
+	tst		x16, #1					// PAR_EL1.F
+	movz	w15, #0xFF00
+	movk	w15, #0xFF00, lsl #16			// green: TTBR0 reaches it
+	b.eq		8f
+	movz	w15, #0x0000
+	movk	w15, #0xFFFF, lsl #16			// red: translation fault
+8:	ldr		x9, [x20, #0x28]
+	bic		x9, x9, #3
+	cbz		x9, 9f
+	ldr		x10, [x20, #0x38]
+	cbz		x10, 9f
+	add		x17, x9, #(4 * (\xoff))			// probe origin, bytes
+	mov		x11, #(\yy)
+	madd	x17, x11, x10, x17
+	SAGIT_FILL
+9:
+.endmacro

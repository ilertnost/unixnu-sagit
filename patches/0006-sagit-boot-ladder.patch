+static uint64_t sagit_ladder_fb;
+static uint32_t sagit_ladder_row;
+static uint64_t sagit_ladder_bytes;
+static uint64_t sagit_ladder_map;
+static unsigned sagit_bar_next;
+static unsigned sagit_paint_next;
